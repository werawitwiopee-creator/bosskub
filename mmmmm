-- Hook Logic
RunBtn.Activated:Connect(function()
    local url = UrlBox.Text
    if url == "" then
        StatusLabel.Text = "สถานะ: ❌ ใส่ URL ก่อน!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
        return
    end

    StatusLabel.Text = "สถานะ: ⏳ กำลังรัน..."
    StatusLabel.TextColor3 = Color3.fromRGB(220, 180, 60)

    local old_ls = loadstring
    getgenv().loadstring = function(code)
        hookedCode = code
        addLog("[Hook] ดักได้! ความยาว: " .. #code .. " ตัวอักษร", Color3.fromRGB(100, 220, 140))
        local chunkSize = 500
        for i = 1, #code, chunkSize do
            addLog(string.sub(code, i, i + chunkSize - 1), Color3.fromRGB(180, 180, 220))
        end
        return old_ls(code)
    end

    local ok, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if ok then
        StatusLabel.Text = "สถานะ: ✅ รันสำเร็จ"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
    else
        StatusLabel.Text = "สถานะ: ❌ Error!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
        addLog("[Error] " .. tostring(err), Color3.fromRGB(220, 100, 100))
    end
end)

ClearBtn.Activated:Connect(function()
    for _, v in pairs(ConsoleBox:GetChildren()) do
        if v:IsA("TextLabel") then v:Destroy() end
    end
    addLog("ล้าง log แล้ว", Color3.fromRGB(120, 120, 160))
    StatusLabel.Text = "สถานะ: รอการใช้งาน"
    StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 160)
end)

CopyBtn.Activated:Connect(function()
    if hookedCode == "" then
        StatusLabel.Text = "สถานะ: ❌ ยังไม่มีโค้ด!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
