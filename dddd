-- ===============================
-- Junk Prefix + Suffix
-- ===============================
local _JUNK_PREFIX = "83260119948695& \n [[191]] &%69=00"
local _JUNK_SUFFIX = "&junk=1"

-- ===============================
-- URL Encode
-- ===============================
local function _urlEncode(id)
    local _hx = "0123456789ABCDEF"
    local r = ""
    for i = 1, #id do
        local b = string.byte(id, i)
        r = r .. "%" .. string.sub(_hx, math.floor(b/16)+1, math.floor(b/16)+1) .. string.sub(_hx, (b%16)+1, (b%16)+1)
    end
    return r
end

-- ===============================
-- สร้าง payload = junk prefix + urlencode(id) + junk suffix
-- ===============================
local function _buildPayload(rawId)
    return _JUNK_PREFIX .. _urlEncode(rawId) .. _JUNK_SUFFIX
end

